  "scripts": {
    "test": "hardhat test && yarn subgraph:template:dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "hardhat:node": "hardhat node --hostname localhost",
    "hardhat:dev": "hardhat --network localhost",
    "hardhat:prod": "hardhat --network xdai",
    "hardhat:mainnet": "hardhat --network mainnet",
    "hardhat:altlayer": "hardhat --network altlayer",
    "hardhat:megaETH": "hardhat --network megaETH",
    "hardhat:redstoneTestnet": "hardhat --network redstoneTestnet",
    "hardhat:redstone": "hardhat --network redstone",
    "hardhat:opSepolia": "hardhat --network opSepolia",
    "compile": "hardhat compile",
    "circom:prod": "hardhat circom --verbose",
    "circom:dev": "hardhat circom --deterministic --verbose --debug",
    "subgraph:template:dev": "yarn hardhat:dev subgraph:codegen",
    "subgraph:template:prod": "yarn hardhat:prod subgraph:codegen",
    "subgraph:deploy:dev": "yarn hardhat:dev subgraph:deploy --name df",
    "subgraph:deploy:prod": "cd subgraph && graph deploy --node https://api.thegraph.com/deploy/ --ipfs https://api.thegraph.com/ipfs/",
    "clean": "del-cli artifacts cache subgraph/build node_modules tsconfig.ref.tsbuildinfo",
    "delete:blockchain": "del-cli blockchain",
    "wait:node": "wait-on tcp:8545",
    "deploy:contracts": "hardhat --network localhost deploy",
    "hardhat:deploy": "run-s wait:node \"deploy:contracts {@}\" --",
    "start": "run-p hardhat:node \"hardhat:deploy {@}\" --",
    "ganache": "npx ganache --chain.chainId 31337 --database.dbPath './blockchain/' -m 'change typical hire slam amateur loan grid fix drama electric seed label'  --wallet.defaultBalance 200000  --wallet.totalAccounts 20 --miner.blockTime=2 --miner.defaultGasPrice=1  --miner.blockGasLimit=100000000",
    "send-eth": "ts-node scripts/send-eth.ts",
    "booth:generate": "ts-node booth/generate-accounts.ts",
    "booth:fund": "ts-node booth/fund-accounts.ts"
  }
}
