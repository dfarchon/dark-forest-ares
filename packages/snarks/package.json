{
  "name": "@dfares/snarks",
  "version": "7.1.4",
  "license": "MIT",
  "author": "0xPARC <ivan@0xPARC.org>",
  "engines": {
    "node": "24.22.1"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.js.map",
    "index.d.ts",
    "index.ts",
    "*.wasm",
    "*.zkey",
    "*.r1cs",
    "interfaces/"
  ],
  "scripts": {
    "prepublishOnly": "npm run build && npm run docs",
    "build": "tsc -p .",
    "test": "exit 0",
    "lint": "eslint .",
    "format": "prettier --write .",
    "docs": "typedoc && npm run format",
    "clean": "del-cli node_modules index.js index.js.map index.d.ts index.d.ts.map tsconfig.ref.tsbuildinfo"
  },
  "peerDependencies": {
    "snarkjs": "0.4.16"
  },
  "devDependencies": {
    "del-cli": "4.0.1",
    "eslint": "7.32.0",
    "prettier": "2.4.1",
    "typedoc": "0.22.13",
    "typedoc-plugin-markdown": "3.11.14",
    "typescript": "5.5.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
